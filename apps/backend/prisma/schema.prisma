// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int                @id @default(autoincrement())
  phone            String             @unique
  first_name       String
  last_name        String
  // Profile picture the user uploaded, stored like every other upload and
  // served through /api/files. Null means "show their initial instead".
  avatar_url       String?
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  reading_progress ReadingProgress[]
  stats            UserStats?
  daily_activity   DailyActivity[]
  quiz_attempts    QuizAttempt[]
  bookmarks        Bookmark[]
  subscriptions    UserSubscription[]
  book_purchases   BookPurchase[]
}

// A one-time code sent by SMS. Codes are stored hashed (never in the clear),
// expire quickly, and are consumed on first successful use. `purpose` keeps the
// app's sign-in codes and the admin dashboard's codes in separate namespaces so
// one can never be replayed against the other.
model OtpCode {
  id          Int       @id @default(autoincrement())
  phone       String
  purpose     String
  code_hash   String
  expires_at  DateTime
  attempts    Int       @default(0)
  consumed_at DateTime?
  created_at  DateTime  @default(now())

  @@index([phone, purpose])
  @@index([expires_at])
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String
  books Book[]
}

// `is_free` is the authoritative flag for whether a book is readable without
// paying — `price_toman` is only meaningful when it is false. Keeping the two
// separate lets an admin park a price on a book while temporarily opening it up.
model Book {
  id                Int            @id @default(autoincrement())
  title             String
  author            String
  short_description String
  full_description  String
  cover_image_url   String?
  is_free           Boolean        @default(true)
  price_toman       Int            @default(0)
  // Cost in XP for buying this book with earned points. 0 (the default) means
  // points cannot be used for it — one field rather than a flag plus an amount,
  // so the two can never disagree. Only meaningful while `is_free` is false.
  points_price      Int            @default(0)
  categories        Category[]
  chapters          Chapter[]
  purchases         BookPurchase[]
}

model Chapter {
  id               Int               @id @default(autoincrement())
  book_id          Int
  book             Book              @relation(fields: [book_id], references: [id], onDelete: Cascade)
  title            String
  chapter_order    Int
  // Free preview inside a paid book. Ignored when the book itself is free.
  is_free          Boolean           @default(false)
  pages            Page[]
  reading_progress ReadingProgress[]
  quiz             Quiz?
  bookmarks        Bookmark[]
}

// Per-user reading progress for a single chapter.
// `last_page` is the furthest page the user has reached; `completed` marks the
// chapter as fully read. One row per (user, chapter).
model ReadingProgress {
  id           Int       @id @default(autoincrement())
  user_id      Int
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  chapter_id   Int
  chapter      Chapter   @relation(fields: [chapter_id], references: [id], onDelete: Cascade)
  last_page    Int       @default(0)
  completed    Boolean   @default(false)
  completed_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@unique([user_id, chapter_id])
  @@index([user_id])
}

// A user's saved bookmark pointing at a specific page within a chapter. One row
// per (user, chapter, page) so re-bookmarking the same page is idempotent.
model Bookmark {
  id          Int      @id @default(autoincrement())
  user_id     Int
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  chapter_id  Int
  chapter     Chapter  @relation(fields: [chapter_id], references: [id], onDelete: Cascade)
  page_number Int
  created_at  DateTime @default(now())

  @@unique([user_id, chapter_id, page_number])
  @@index([user_id])
}

model Page {
  id           Int     @id @default(autoincrement())
  chapter_id   Int
  chapter      Chapter @relation(fields: [chapter_id], references: [id], onDelete: Cascade)
  page_number  Int
  text_content String?
  image_urls   String // Store JSON-serialized array of strings, e.g., '["url1", "url2"]'
  is_full_page Boolean @default(false)
}

// Aggregate gamification stats for a user. One row per user, created lazily on
// the user's first tracked activity. `last_activity_date` is stored as the UTC
// instant of Tehran-midnight for the day the user was last active, which lets us
// compare "activity days" without a timezone library.
model UserStats {
  id                 Int       @id @default(autoincrement())
  user_id            Int       @unique
  user               User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  total_xp           Int       @default(0)
  // XP the user has redeemed (currently: buying books with points). `total_xp`
  // stays a lifetime "earned" figure so streaks and history are never rewritten;
  // the spendable balance is total_xp - spent_xp.
  spent_xp           Int       @default(0)
  current_streak     Int       @default(0)
  longest_streak     Int       @default(0)
  last_activity_date DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
}

// One row per (user, activity-day). `date` is the UTC instant of Tehran-midnight
// for that day. Used to render the activity calendar and to power the streak.
model DailyActivity {
  id         Int      @id @default(autoincrement())
  user_id    Int
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  date       DateTime
  xp_earned  Int      @default(0)
  created_at DateTime @default(now())

  @@unique([user_id, date])
  @@index([user_id])
}

// A single quiz attached to a chapter (lesson). One quiz per chapter.
model Quiz {
  id         Int            @id @default(autoincrement())
  chapter_id Int            @unique
  chapter    Chapter        @relation(fields: [chapter_id], references: [id], onDelete: Cascade)
  title      String?
  // Minimum fraction of correct answers (0..1) required to "pass" the quiz.
  pass_ratio Float          @default(0.6)
  questions  QuizQuestion[]
  attempts   QuizAttempt[]
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt
}

model QuizQuestion {
  id             Int          @id @default(autoincrement())
  quiz_id        Int
  quiz           Quiz         @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  prompt         String
  options        String // JSON-serialized array of strings, e.g., '["A","B","C"]'
  correct_index  Int
  question_order Int          @default(0)
  answers        QuizAnswer[]

  @@index([quiz_id])
}

// One attempt of a quiz by a user. Users may attempt a quiz multiple times.
model QuizAttempt {
  id           Int          @id @default(autoincrement())
  user_id      Int
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  quiz_id      Int
  quiz         Quiz         @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  score        Int // number of correct answers
  total        Int // number of questions at attempt time
  passed       Boolean      @default(false)
  xp_awarded   Int          @default(0)
  completed_at DateTime     @default(now())
  answers      QuizAnswer[]

  @@index([user_id])
  @@index([quiz_id])
}

model QuizAnswer {
  id             Int          @id @default(autoincrement())
  attempt_id     Int
  attempt        QuizAttempt  @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  question_id    Int
  question       QuizQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)
  selected_index Int
  is_correct     Boolean

  @@index([attempt_id])
}

// An admin-defined subscription offer, e.g. "3 months for 500,000 tomans".
// `duration_months` is free-form so an admin can create any period they like.
// Plans are soft-retired via `is_active` rather than deleted, so subscriptions
// sold under an old plan keep pointing at something meaningful.
model SubscriptionPlan {
  id              Int                @id @default(autoincrement())
  title           String
  duration_months Int
  price_toman     Int
  is_active       Boolean            @default(true)
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt
  subscriptions   UserSubscription[]
}

// A granted subscription window. A user is "subscribed" when they have any row
// whose `expires_at` is still in the future; overlapping rows simply extend
// coverage. `plan_id` is nullable so retiring a plan never orphans a grant.
model UserSubscription {
  id         Int               @id @default(autoincrement())
  user_id    Int
  user       User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  plan_id    Int?
  plan       SubscriptionPlan? @relation(fields: [plan_id], references: [id], onDelete: SetNull)
  starts_at  DateTime          @default(now())
  expires_at DateTime
  created_at DateTime          @default(now())

  @@index([user_id])
  @@index([expires_at])
}

// A one-off purchase granting permanent access to a single book. `price_toman`
// records what the book cost at purchase time, so later price changes don't
// rewrite history. A purchase paid for with points records the XP charged in
// `points_spent` and leaves `price_toman` at 0.
model BookPurchase {
  id          Int      @id @default(autoincrement())
  user_id     Int
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  book_id     Int
  book        Book     @relation(fields: [book_id], references: [id], onDelete: Cascade)
  price_toman  Int     @default(0)
  points_spent Int     @default(0)
  created_at  DateTime @default(now())

  @@unique([user_id, book_id])
  @@index([user_id])
}
