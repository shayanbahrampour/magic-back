# Copy to .env and fill in. Never commit real values.

DATABASE_URL=postgresql://user:password@localhost:5432/magicbook

# Signs admin/user JWTs. Also peppers OTP hashes unless OTP_PEPPER is set.
JWT_SECRET=change-me

# Comma-separated phones allowed into the admin dashboard.
ADMIN_PHONES=09xxxxxxxxx

# sms.ir OTP delivery. With the key absent the backend logs codes instead of
# sending them, which is what you want locally.
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
SMSIR_CODE_PARAM=CODE

# Zibal internet payment gateway (IPG).
# Leaving ZIBAL_MERCHANT empty falls back to Zibal's sandbox merchant `zibal`,
# which accepts any card and never moves real money — that is the local default.
ZIBAL_MERCHANT=
# The publicly reachable origin of THIS backend. Zibal redirects the payer to
# `${PUBLIC_BASE_URL}/api/payments/callback`, so it must be https, reachable
# from the open internet, and registered as the gateway's site in the Zibal
# panel (otherwise every payment request is rejected with result 106).
PUBLIC_BASE_URL=https://api.magic-book.ir
# The app's URL scheme, used to hand the payer back to the app after checkout.
# Must match `expo.scheme` in the client's app.json.
APP_RETURN_SCHEME=magic
# Optional. Comma-separated services used by GET /api/payments/config/check to
# report the server's outbound IP — the address Zibal's allowlist checks. The
# built-in list tries ipnumberia.com first, then foreign fallbacks; override it
# if none of those are reachable from your host.
IP_ECHO_URLS=

# Myket in-app billing (the Android build published on Myket). The access token
# is in the Myket developer panel's in-app products section; the package name is
# `expo.android.package` from the app's app.json. Without both, Myket purchases
# stay pending and the app retries them on its next launch.
MYKET_ACCESS_TOKEN=
MYKET_PACKAGE_NAME=

# Object storage (S3 / MinIO)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
