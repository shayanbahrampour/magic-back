# Copy to .env and fill in. Never commit real values.

DATABASE_URL=postgresql://user:password@localhost:5432/magicbook

# Signs admin/user JWTs. Also peppers OTP hashes unless OTP_PEPPER is set.
JWT_SECRET=change-me

# Comma-separated phones allowed into the admin dashboard.
ADMIN_PHONES=09xxxxxxxxx

# sms.ir OTP delivery. With the key absent the backend logs codes instead of
# sending them, which is what you want locally.
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
SMSIR_CODE_PARAM=CODE

# Object storage (S3 / MinIO)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
