{
  "name": "reading-app-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for reading app with Backend and Admin Frontend",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "dev:admin": "npm run dev -w admin",
    "build:backend": "npm run build -w backend",
    "build:admin": "npm run build -w admin",
    "start:backend": "npm run start -w backend"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
